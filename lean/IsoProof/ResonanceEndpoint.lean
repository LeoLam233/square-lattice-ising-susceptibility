import Mathlib.NumberTheory.NumberField.InfinitePlace.Embeddings
import Mathlib.RingTheory.RootsOfUnity.Minpoly
import Mathlib.Analysis.Complex.Basic
import Mathlib.Analysis.Normed.Ring.Finite
import Mathlib.Tactic

/-!
# The algebraic-integer endpoint exclusion

This is the general arithmetic argument in §4, independent of the selected
prime subfamily.  An algebraically integral cosine of a root of unity is
-1, 0 or 1, by Kronecker's theorem in the finite field generated by that root.
Thus an endpoint trace 2(x-1), with x integral and 0<x<2, x≠1, cannot be the
trace of a root of unity.
-/
namespace IsoProof
noncomputable section
open Complex IntermediateField
open scoped IntermediateField
set_option maxHeartbeats 1000000
set_option backward.isDefEq.respectTransparency false

/-- An algebraically integral real cosine of a root of unity is -1, 0 or 1.
All conjugates are bounded using the actual finite-order equation. -/
theorem integral_rootUnity_cosine_cases {c : ℝ} {z : ℂ}
    (hz : IsOfFinOrder z) (hc : IsIntegral ℤ (c:ℂ))
    (htrace : z+z⁻¹=2*(c:ℂ)) : c= -1 ∨ c=0 ∨ c=1 := by
  by_cases hc0 : c=0
  · exact Or.inr (Or.inl hc0)
  have hzI : IsIntegral ℤ z := (IsPrimitiveRoot.orderOf z).isIntegral hz.orderOf_pos
  let K := ℚ⟮z⟯
  have : FiniteDimensional ℚ K := IntermediateField.adjoin.finiteDimensional hzI.tower_top
  have : NumberField K := {}
  let x : K := IntermediateField.AdjoinSimple.gen ℚ z
  let u : K := (x+x⁻¹)/2
  have hxcast : algebraMap K ℂ x=z := rfl
  have hucast : algebraMap K ℂ u=(c:ℂ) := by
    simp only [u,map_div₀,map_add,map_inv₀,map_ofNat,hxcast,htrace]
    ring
  have hxroot : IsOfFinOrder x := by
    obtain ⟨N,hN,hzN⟩ := hz.exists_pow_eq_one
    apply isOfFinOrder_iff_pow_eq_one.mpr
    refine ⟨N,hN,?_⟩
    apply Subtype.ext
    exact hzN
  have hu0 : u≠0 := by
    intro hu
    have hc' : (c:ℂ)=0 := by rw [←hucast,hu,map_zero]
    exact hc0 (Complex.ofReal_eq_zero.mp hc')
  have huI : IsIntegral ℤ u := by
    apply (isIntegral_algebraMap_iff (R:=ℤ) (A:=K) (B:=ℂ)).mp
    rw [hucast]
    exact hc
  have hbound (φ : K→+*ℂ) : ‖φ u‖≤1 := by
    have hxnorm : ‖φ x‖=1 := (φ.toMonoidHom.isOfFinOrder hxroot).norm_eq_one
    have hadd := norm_add_le (φ x) ((φ x)⁻¹)
    rw [norm_inv,hxnorm] at hadd
    simp only [u,map_div₀,map_add,map_inv₀,map_ofNat,norm_div]
    norm_num
    linarith
  obtain ⟨N,hN,huN⟩ :=
    NumberField.Embeddings.pow_eq_one_of_norm_le_one K ℂ hu0 huI hbound
  have hcroot : IsOfFinOrder (c:ℂ) := by
    apply isOfFinOrder_iff_pow_eq_one.mpr
    refine ⟨N,hN,?_⟩
    rw [←hucast,←map_pow,huN,map_one]
  have hcnorm := hcroot.norm_eq_one
  rw [Complex.norm_real,Real.norm_eq_abs] at hcnorm
  rcases le_total 0 c with hcpos | hcneg
  · rw [abs_of_nonneg hcpos] at hcnorm
    exact Or.inr (Or.inr hcnorm)
  · rw [abs_of_nonpos hcneg] at hcnorm
    exact Or.inl (by linarith)

/-- The level itself is integral whenever it is the real trace of a
root of unity, as for x=2 cos α on the rational angular grid. -/
theorem real_rootUnity_trace_integral {x : ℝ} {w : ℂ}
    (hw : IsOfFinOrder w) (htrace : w+w⁻¹=(x:ℂ)) :
    IsIntegral ℤ (x:ℂ) := by
  have hi := (IsPrimitiveRoot.orderOf w).isIntegral hw.orderOf_pos
  have hinv := (IsPrimitiveRoot.orderOf w).inv.isIntegral hw.orderOf_pos
  rw [←htrace]
  exact hi.add hinv

/-- General endpoint exclusion from the short paper.  The input is the
algebraic integrality of the actual level x and its exact endpoint trace. -/
theorem endpoint_not_rootUnity_of_integral_level {x : ℝ} {z : ℂ}
    (hx : IsIntegral ℤ (x:ℂ)) (hx0 : 0<x) (hx2 : x<2) (hx1 : x≠1)
    (htrace : z+z⁻¹=2*((x:ℂ)-1)) : ¬IsOfFinOrder z := by
  intro hz
  have hc : IsIntegral ℤ ((x-1:ℝ):ℂ) := by
    simpa only [Complex.ofReal_sub,Complex.ofReal_one] using hx.sub isIntegral_one
  have ht : z+z⁻¹=2*((x-1:ℝ):ℂ) := by
    simpa only [Complex.ofReal_sub,Complex.ofReal_one] using htrace
  rcases integral_rootUnity_cosine_cases hz hc ht with h | h | h
  · linarith
  · exact hx1 (by linarith)
  · linarith

/-- Neither endpoint sign can occur at any positive particle number. -/
theorem endpoint_power_ne_signs_of_integral_level {x : ℝ} {z : ℂ}
    (hx : IsIntegral ℤ (x:ℂ)) (hx0 : 0<x) (hx2 : x<2) (hx1 : x≠1)
    (htrace : z+z⁻¹=2*((x:ℂ)-1)) (N : ℕ) (hN : 0<N) :
    z^N≠1 ∧ z^N≠ -1 := by
  have hfin := endpoint_not_rootUnity_of_integral_level hx hx0 hx2 hx1 htrace
  constructor
  · intro h
    exact hfin (isOfFinOrder_iff_pow_eq_one.mpr ⟨N,hN,h⟩)
  · intro h
    apply hfin
    apply isOfFinOrder_iff_pow_eq_one.mpr
    refine ⟨N*2,by omega,?_⟩
    rw [pow_mul,h]
    norm_num

/-- Endpoint exclusion with the integrality input supplied by the actual
rational-grid root of unity.  Neither the endpoint exclusion nor a
nonresonance statement occurs among the hypotheses. -/
theorem endpoint_power_ne_signs_of_rootUnity_level {x : ℝ} {w z : ℂ}
    (hw : IsOfFinOrder w) (hwtrace : w+w⁻¹=(x:ℂ))
    (hx0 : 0<x) (hx2 : x<2) (hx1 : x≠1)
    (hztrace : z+z⁻¹=2*((x:ℂ)-1)) (N : ℕ) (hN : 0<N) :
    z^N≠1 ∧ z^N≠ -1 :=
  endpoint_power_ne_signs_of_integral_level (real_rootUnity_trace_integral hw hwtrace)
    hx0 hx2 hx1 hztrace N hN

end
end IsoProof
