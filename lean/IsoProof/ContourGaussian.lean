import Mathlib.Analysis.SpecialFunctions.Gaussian.GaussianIntegral
import Mathlib.MeasureTheory.Integral.Pi
import Mathlib.MeasureTheory.Group.Integral
import Mathlib.Tactic

/-! The N-dimensional Gaussian integration step in equation (6).
The exponent N/2 is generated by an actual product integral; it is not
assumed as a numerical envelope. -/
namespace IsoProof
noncomputable section
open scoped BigOperators
open MeasureTheory Set

def centeredGaussian (N : ℕ) (β c : ℝ) (r : Fin N → ℝ) : ℝ :=
  ∏ i, Real.exp (-β*(r i-c)^2)

theorem centeredGaussian_nonneg (N : ℕ) (β c : ℝ) (r : Fin N → ℝ) :
    0 ≤ centeredGaussian N β c r := Finset.prod_nonneg (fun _ _ => (Real.exp_pos _).le)

theorem centeredGaussian_integrable (N : ℕ) {β : ℝ} (hβ : 0 < β) (c : ℝ) :
    Integrable (centeredGaussian N β c) := by
  exact Integrable.fintype_prod (fun _ : Fin N => (integrable_exp_neg_mul_sq hβ).comp_sub_right c)

theorem centeredGaussian_integral (N : ℕ) (β c : ℝ) :
    (∫ r, centeredGaussian N β c r) = (Real.sqrt (Real.pi/β))^N := by
  unfold centeredGaussian
  rw [integral_fintype_prod_volume_eq_pow (fun r : ℝ => Real.exp (-β*(r-c)^2))]
  rw [integral_sub_right_eq_self (fun x : ℝ => Real.exp (-β*x^2)) c,integral_gaussian]
  simp

/-- Integrating any actual Gaussian-dominated complex density over a
measurable angular cell produces the exact N-dimensional Gaussian factor. -/
theorem norm_setIntegral_le_gaussian (N : ℕ) {β K : ℝ} (hβ : 0 < β) (hK : 0 ≤ K)
    (c : ℝ) (S : Set (Fin N → ℝ)) (hS : MeasurableSet S) (F : (Fin N → ℝ) → ℂ)
    (hF : IntegrableOn F S) (hbound : ∀ r ∈ S, ‖F r‖ ≤ K*centeredGaussian N β c r) :
    ‖∫ r in S, F r‖ ≤ K*(Real.sqrt (Real.pi/β))^N := by
  have hG : Integrable (fun r => K*centeredGaussian N β c r) :=
    (centeredGaussian_integrable N hβ c).const_mul K
  calc
    _ ≤ ∫ r in S, ‖F r‖ := norm_integral_le_integral_norm _
    _ ≤ ∫ r in S, K*centeredGaussian N β c r := by
      apply integral_mono_ae hF.norm hG.integrableOn
      filter_upwards [ae_restrict_mem hS] with r hr
      exact hbound r hr
    _ ≤ ∫ r, K*centeredGaussian N β c r :=
      setIntegral_le_integral hG (Filter.Eventually.of_forall (fun r =>
        mul_nonneg hK (centeredGaussian_nonneg N β c r)))
    _ = K*(Real.sqrt (Real.pi/β))^N := by
      rw [integral_const_mul,centeredGaussian_integral]

theorem gaussian_one_coordinate_decay {a A : ℝ} (ha : 0 < a) (hA : 1 ≤ A) :
    Real.sqrt (Real.pi/(a*A)) ≤
      Real.sqrt (2*Real.pi/a)*(1+A)^(-1/2 : ℝ) := by
  have hA0 : 0 < A := lt_of_lt_of_le zero_lt_one hA
  have hA1 : 0 < 1+A := by linarith
  have hr : Real.pi/(a*A) ≤ (2*Real.pi/a)/(1+A) := by
    apply (div_le_div_iff₀ (mul_pos ha hA0) hA1).mpr
    field_simp
    nlinarith [Real.pi_pos]
  calc
    _ ≤ Real.sqrt ((2*Real.pi/a)/(1+A)) := Real.sqrt_le_sqrt hr
    _ = Real.sqrt (2*Real.pi/a)/Real.sqrt (1+A) := Real.sqrt_div (by positivity) _
    _ = Real.sqrt (2*Real.pi/a)*(1+A)^(-1/2 : ℝ) := by
      simp_rw [div_eq_mul_inv,Real.sqrt_eq_rpow]
      rw [← Real.rpow_neg hA1.le]
      norm_num

theorem gaussian_N_coordinate_decay (N : ℕ) {a A : ℝ} (ha : 0 < a) (hA : 1 ≤ A) :
    (Real.sqrt (Real.pi/(a*A)))^N ≤
      (Real.sqrt (2*Real.pi/a))^N*(1+A)^(-(N : ℝ)/2) := by
  have h := pow_le_pow_left₀ (Real.sqrt_nonneg _) (gaussian_one_coordinate_decay ha hA) N
  rw [mul_pow,← Real.rpow_mul_natCast (by linarith : 0 ≤ 1+A)] at h
  convert h using 1
  congr 1
  ring

/-- Exact scaling for the uniformly shifted lattice radius, including the
origin. Each angular integration contributes one inverse square root. -/
theorem gaussian_N_shifted_scaling (N : ℕ) {β A : ℝ} (hβ : 0 < β) (hA : 0 ≤ A) :
    (Real.sqrt (Real.pi/(β*(1+A))))^N =
      (Real.sqrt (Real.pi/β))^N*(1+A)^(-(N : ℝ)/2) := by
  have hA1 : 0 < 1+A := by linarith
  have he : Real.sqrt (Real.pi/(β*(1+A))) =
      Real.sqrt (Real.pi/β)*(1+A)^(-1/2 : ℝ) := by
    rw [show Real.pi/(β*(1+A))=(Real.pi/β)/(1+A) by rw [div_div],
      Real.sqrt_div (by positivity)]
    simp_rw [div_eq_mul_inv,Real.sqrt_eq_rpow]
    rw [← Real.rpow_neg hA1.le]
    norm_num
  rw [he,mul_pow,← Real.rpow_mul_natCast hA1.le]
  congr 2
  ring

/-- The one-variable version needs only integrability of the Gaussian
majorant, as in mathlib's norm domination theorem. -/
theorem norm_intervalIntegral_le_gaussian {β K : ℝ} (hβ : 0 < β) (hK : 0 ≤ K)
    (c u v : ℝ) (huv : u ≤ v) (F : ℝ → ℂ)
    (hbound : ∀ r ∈ Icc u v, ‖F r‖ ≤ K*Real.exp (-β*(r-c)^2)) :
    ‖∫ r in u..v, F r‖ ≤ K*Real.sqrt (Real.pi/β) := by
  have hG : Integrable (fun r : ℝ => K*Real.exp (-β*(r-c)^2)) :=
    ((integrable_exp_neg_mul_sq hβ).comp_sub_right c).const_mul K
  rw [intervalIntegral.integral_of_le huv]
  calc
    _ ≤ ∫ r in Ioc u v, K*Real.exp (-β*(r-c)^2) := by
      apply MeasureTheory.norm_integral_le_of_norm_le hG.integrableOn
      filter_upwards [ae_restrict_mem measurableSet_Ioc] with r hr
      exact hbound r ⟨hr.1.le,hr.2⟩
    _ ≤ ∫ r : ℝ, K*Real.exp (-β*(r-c)^2) :=
      setIntegral_le_integral hG (Filter.Eventually.of_forall (fun r => by positivity))
    _ = K*Real.sqrt (Real.pi/β) := by
      rw [integral_const_mul,integral_sub_right_eq_self (fun r : ℝ => Real.exp (-β*r^2)) c,
        integral_gaussian]

end
end IsoProof
